% Gemini theme — adapted for 60×160 cm poster (lonaria)
% Based on https://github.com/anishathalye/gemini

% ====================
% Dependencies
% ====================
\RequirePackage{exscale}
\RequirePackage{ragged2e}
\RequirePackage{changepage}
\RequirePackage{fontspec}
\RequirePackage{calc}
\RequirePackage{DejaVuSans}

% ====================
% Fonts
% ====================
\newfontfamily\DejaVuSans[Ligatures=TeX]{DejaVuSans}

\setmainfont{DejaVuSans}
\setsansfont{DejaVuSans}

% For a 60×200 cm poster at scale=1.25 the "paper" in TeX units is
% 60 cm / 1.25 = 48 cm wide  ×  200 cm / 1.25 = 160 cm tall.
% Font sizes and vertical spacings below are tuned for a taller canvas.

\setbeamerfont{headline}{family=\DejaVuSans}
\setbeamerfont{headline title}{size=\LARGE,series=\bfseries}
\setbeamerfont{headline author}{size=\large}
\setbeamerfont{headline institute}{size=\normalsize}

\setbeamerfont{heading}{family=\DejaVuSans,series=\bfseries}
\setbeamerfont{caption}{size=\small,series=\itshape}
\setbeamerfont{footline}{family=\DejaVuSans,size=\small}
\setbeamerfont{block title}{family=\DejaVuSans,size=\large,series=\bfseries}
\setbeamerfont{block example title}{family=\DejaVuSans,size=\normalsize,series=\bfseries}

% ====================
% Macros
% ====================
\newcommand{\samelineand}{\qquad}

% ====================
% Elements
% ====================

% List — tighter spacing for tall-narrow format
\makeatletter
\def\@listi{\leftmargin\leftmarginii
  \topsep 0.5ex
  \parsep 0\p@ \@plus\p@
  \itemsep 0.3ex}
\makeatother

% Itemize
\setbeamertemplate{itemize item}{\raise0.5ex \hbox{\vrule width 0.5ex height 0.5ex}}
\setbeamertemplate{itemize subitem}{\raise0.3ex \hbox{\vrule width 0.5ex height 0.5ex}}
\setbeamertemplate{itemize subsubitem}{\raise0.2ex \hbox{\vrule width 0.5ex height 0.5ex}}

% Enumerate
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertsubenumlabel.}
\setbeamertemplate{enumerate subsubitem}{\insertsubsubenumlabel.}

% Equation
\setlength\belowdisplayshortskip{1.5ex}

% Caption
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{caption label separator}[period]
\setlength{\abovecaptionskip}{1ex}
\setlength{\belowcaptionskip}{0.5ex}

% Bibliography
\setbeamertemplate{bibliography item}[text]

% Navigation
\beamertemplatenavigationsymbolsempty

% ====================
% Components
% ====================

% Heading
\newcommand\heading[1]{%
  \par\medskip
  {\usebeamerfont{heading}\usebeamercolor[fg]{heading}#1}\par\smallskip
}

% Logos
\newlength{\logoleftwidth}
\setlength{\logoleftwidth}{0cm}
\newlength{\logorightwidth}
\setlength{\logorightwidth}{0cm}
\newlength{\maxlogowidth}
\setlength{\maxlogowidth}{0cm}

\newcommand{\logoright}[1]{
  \newcommand{\insertlogoright}{#1}
  \settowidth{\logorightwidth}{\insertlogoright}
  \addtolength{\logorightwidth}{8ex}
  \setlength{\maxlogowidth}{\maxof{\logoleftwidth}{\logorightwidth}}
}
\newcommand{\logoleft}[1]{
  \newcommand{\insertlogoleft}{#1}
  \settowidth{\logoleftwidth}{\insertlogoleft}
  \addtolength{\logoleftwidth}{8ex}
  \setlength{\maxlogowidth}{\maxof{\logoleftwidth}{\logorightwidth}}
}

% ====================
% Headline — optimised for 60×160 cm
% Logos are placed via TikZ overlay in the main file;
% this headline only renders the title/author/institute block.
% ====================
\setbeamertemplate{headline}
{
  \begin{beamercolorbox}{headline}
    \vskip8ex
    \begin{columns}
      \begin{column}{\maxlogowidth}
        \vskip6ex
        \ifdefined\insertlogoleft
          \vspace*{\fill}
          \hspace{6ex}
          \raggedright
          \insertlogoleft
          \vspace*{\fill}
        \else\fi
      \end{column}
      \begin{column}{\dimexpr\paperwidth-\maxlogowidth-\maxlogowidth}
        \usebeamerfont{headline}
        \vskip4ex
        \centering
        {\usebeamerfont{headline title}\usebeamercolor[fg]{headline title}\inserttitle\\[1.2ex]}
        {\usebeamerfont{headline author}\usebeamercolor[fg]{headline author}\insertauthor\\[1.6ex]}
        {\usebeamerfont{headline institute}\usebeamercolor[fg]{headline institute}\insertinstitute\\[3ex]}
      \end{column}
      \begin{column}{\maxlogowidth}
        \vskip6ex
        \ifdefined\insertlogoright
          \vspace*{\fill}
          \raggedleft
          \insertlogoright
          \hspace{6ex}
          \vspace*{\fill}
        \else\fi
      \end{column}
    \end{columns}
    \vskip6ex
    \ifbeamercolorempty[bg]{headline rule}{}{
      \begin{beamercolorbox}[wd=\paperwidth,colsep=0.5ex]{headline rule}\end{beamercolorbox}
    }
  \end{beamercolorbox}
}

% ====================
% Block — tighter vertical rhythm for lonaria format
% ====================
\setbeamertemplate{block begin}
{
  \begin{beamercolorbox}[colsep*=0ex,dp=2.5ex,center]{block title}
    \vskip-1.5ex
    \usebeamerfont{block title}\insertblocktitle
    \vskip-2ex
    \begin{beamercolorbox}[colsep=0.025ex]{block separator}\end{beamercolorbox}
  \end{beamercolorbox}
  {\parskip0pt\par}
  \setbeamerfont{block body}{size=\large}
  \usebeamerfont{block body}
  \vskip0ex
  \begin{beamercolorbox}[colsep*=0ex]{block body}
    \justifying
    \setlength{\parskip}{1.2ex}
    \vskip-2.5ex
}
\setbeamertemplate{block end}
{
  \end{beamercolorbox}
  \vspace*{3ex}
}

% ====================
% Alert Block
% ====================
\setbeamertemplate{block alerted begin}
{
  \begin{beamercolorbox}[colsep*=0ex,dp=2.5ex,center]{block alerted title}
    \vskip0pt
    \usebeamerfont{block title}\insertblocktitle
    \vskip-1.5ex
    \begin{beamercolorbox}[colsep=0.025ex]{block alerted separator}\end{beamercolorbox}
  \end{beamercolorbox}
  {\parskip0pt\par}
  \setbeamerfont{block body}{size=\large}
  \usebeamerfont{block body}
  \vskip-1ex
  \begin{beamercolorbox}[colsep*=0ex]{block alerted body}
    \justifying
    \begin{adjustwidth}{1ex}{1ex}
    \setlength{\parskip}{1.2ex}
    \vskip-2.5ex
}
\setbeamertemplate{block alerted end}
{
    \end{adjustwidth}
    \vskip1.2ex
  \end{beamercolorbox}
  \vspace*{3ex}
}

% ====================
% Example Block
% ====================
\setbeamertemplate{block example begin}
{
  \begin{beamercolorbox}[colsep*=0ex,dp=2.5ex,center]{block example title}
    \vskip0pt
    \usebeamerfont{block example title}\insertblocktitle
    \vskip-1.5ex
    \begin{beamercolorbox}[colsep=0.025ex]{block example separator}\end{beamercolorbox}
  \end{beamercolorbox}
  {\parskip0pt\par}
  \setbeamerfont{block body}{size=\normalsize}
  \usebeamerfont{block body}
  \vskip-1ex
  \begin{beamercolorbox}[colsep*=0ex]{block example body}
    \justifying
    \begin{adjustwidth}{1ex}{1ex}
    \setlength{\parskip}{1.2ex}
    \vskip-2.5ex
}
\setbeamertemplate{block example end}
{
    \end{adjustwidth}
    \vskip1.2ex
  \end{beamercolorbox}
  \vspace*{3ex}
}

% ====================
% Footer
% ====================
\newcommand{\footercontent}[1]{\newcommand{\insertfootercontent}{#1}}

\setbeamertemplate{footline}{
  \ifdefined\insertfootercontent
  \begin{beamercolorbox}[vmode]{headline}
    \ifbeamercolorempty[bg]{headline rule}{}{
      \begin{beamercolorbox}[wd=\paperwidth,colsep=0.25ex]{headline rule}\end{beamercolorbox}
    }
    \vspace{1.2cm}
    \hspace{0.05\paperwidth}
    \usebeamerfont{footline}
    \centering
    \insertfootercontent
    \hspace{0.05\paperwidth}
    \vspace{1.2cm}
  \end{beamercolorbox}
  \else\fi
}
